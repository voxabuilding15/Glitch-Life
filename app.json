{
  "expo": {
    "name": "Glitch Life",
    "slug": "glitch-life",
    "scheme": "glitchlife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#021024",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#021024"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glitchlife.app"
    },
    "android": {
      "package": "com.glitchlife.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#021024"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#5483B3"
        }
      ]
    ]
  }
}
